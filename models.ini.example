; models.ini — model registry for gguf-rs-server, in the same spirit as llama.cpp's
; --models-preset router file. Keys match gguf-rs CLI flag names where they exist.
;
; [*] holds global defaults applied to every model unless a model section overrides
; the same key. Each other [section] name becomes the "model" ID clients pass in API
; requests, e.g. {"model": "qwen", "messages": [...]}. The server looks the ID up here,
; loads that model if it isn't already the one resident in memory, and applies its
; settings.
;
; Only one model is ever loaded at a time — requesting a different model unloads the
; current one (once its in-flight requests finish) and loads the new one.
;
; mmproj (vision) is accepted for compatibility with llama.cpp config files but is not
; supported yet — it's parsed and ignored with a warning.
; ngl/n-gpu-layers: this engine doesn't do partial layer offload, so any nonzero value
; means "use the GPU" and 0 means CPU-only.

[*]
ctx-size = 8192
temp = 0.7
top-k = 40
top-p = 0.9
rep-penalty = 1.1
ngl = -1
parallel = 4
load-on-startup = false

[qwen]
model = ./models/qwen2.5-7b-instruct-q4_k_m.gguf
temp = 0.4

[gemma]
model = ./models/gemma-2-2b-it-q4_k_m.gguf
ctx-size = 16384
load-on-startup = true
