#version 450
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) readonly buffer K  { float k[]; };
layout(set = 0, binding = 1) readonly buffer V  { float v[]; };
// See attention.comp: uint storage so one declaration covers f32 and packed f16.
layout(set = 0, binding = 2) buffer KC          { uint k_cache[]; };
layout(set = 0, binding = 3) buffer VC          { uint v_cache[]; };

// 0 = f32 storage, 1 = f16.
layout(constant_id = 0) const int KV_TYPE = 0;

layout(push_constant) uniform PC {
    uint dim;
    uint stride;
    uint base;
    uint start_pos;
    uint n_tokens;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;
    // f16 packs two values per word, so one invocation owns a pair. `dim` and `stride` are
    // both multiples of the head dimension and therefore even, so a pair never straddles
    // two token slots.
    uint per = KV_TYPE == 0 ? 1u : 2u;
    uint total = (pc.dim * pc.n_tokens) / per;
    if (idx >= total) return;

    uint e = idx * per;
    uint t = e / pc.dim;
    uint i = e % pc.dim;
    uint off = (pc.base + pc.start_pos + t) * pc.stride + i;
    uint src = t * pc.dim + i;

    if (KV_TYPE == 0) {
        k_cache[off] = floatBitsToUint(k[src]);
        v_cache[off] = floatBitsToUint(v[src]);
    } else {
        k_cache[off >> 1u] = packHalf2x16(vec2(k[src], k[src + 1u]));
        v_cache[off >> 1u] = packHalf2x16(vec2(v[src], v[src + 1u]));
    }
}
