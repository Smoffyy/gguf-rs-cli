#version 450
// The small MoE steps that are not matmuls.
//
// op 0: replicate each token's activation into its expert slots
// op 1: fused gate/up activation across every slot
// op 2: weighted sum of each token's expert outputs
layout(local_size_x = 256) in;

layout(set = 0, binding = 0) buffer Dst          { float dst[]; };
layout(set = 0, binding = 1) readonly buffer A   { float a[]; };
layout(set = 0, binding = 2) readonly buffer B   { float b[]; };

layout(push_constant) uniform PC {
    uint n;
    uint dim;
    uint n_used;
    uint n_tokens;
    uint op;
    uint act;
    uint has_gate;
    float alpha;
} pc;

float act_apply(uint act, float x, float alpha) {
    if (act == 0u) return x / (1.0 + exp(-x));
    if (act == 1u || act == 2u) return 0.5 * x * (1.0 + tanh(0.7978845608 * (x + 0.044715 * x * x * x)));
    if (act == 3u) return x / (1.0 + exp(-1.702 * x));
    if (act == 4u) return max(x, 0.0);
    if (act == 5u) { float r = max(x, 0.0); return r * r; }
    return x / (1.0 + exp(-alpha * x));
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    if (pc.op == 0u) {
        uint d = i % pc.dim;
        uint slot = i / pc.dim;
        uint t = slot / pc.n_used;
        dst[i] = a[t * pc.dim + d];
    } else if (pc.op == 1u) {
        dst[i] = pc.has_gate != 0u
            ? act_apply(pc.act, dst[i], pc.alpha) * a[i]
            : act_apply(pc.act, a[i], pc.alpha);
    } else {
        uint d = i % pc.dim;
        uint t = i / pc.dim;
        float acc = 0.0;
        for (uint k = 0u; k < pc.n_used; ++k) {
            uint slot = t * pc.n_used + k;
            acc += b[slot] * a[slot * pc.dim + d];
        }
        dst[i] = acc;
    }
}
